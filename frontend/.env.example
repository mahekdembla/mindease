# Frontend environment variables for Vite
# Copy this file to .env.local and fill in values.

# Backend API URL — leave blank for local development (defaults to http://127.0.0.1:8000).
# Set to your Render / Railway URL in the Vercel / Netlify dashboard:
#   e.g. https://mindease-backend.onrender.com
VITE_API_URL=
