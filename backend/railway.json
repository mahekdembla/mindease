# railway.json — Railway.app deployment configuration for MindEase backend.
#
# Deploy steps:
#   1. Install the Railway CLI: npm i -g @railway/cli
#   2. railway login && railway link
#   3. railway up
#
# Or connect via the Railway dashboard → New Project → Deploy from GitHub repo.
# Railway will auto-detect this file.
#
# Set environment variables in the Railway dashboard under your service's Variables tab.

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
