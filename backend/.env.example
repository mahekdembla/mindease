SENDER_EMAIL=
SENDER_PASSWORD=
GROQ_API_KEY=
MONGODB_URI=
MINDEASE_DB_NAME=mindease

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback

JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Production: set to your deployed frontend URL (e.g. https://mindease.vercel.app).
# Used for OAuth redirects and CORS; several origins may be comma-separated (first = redirect target).
# Leave blank during local development.
FRONTEND_URL=

# AI reply tuning (optional) - see rag.py
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=medium      # low | medium | high (gpt-oss models only)
# LLM_MAX_TOKENS=1500              # per reply, incl. hidden reasoning; Groq reserves it against the per-minute budget
# FALLBACK_LLM_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b  # tried in order when LLM_MODEL is rate-limited
# BACKGROUND_LLM_MODEL=openai/gpt-oss-20b  # memory notes, insights, daily reminder (separate budget)

# Low-memory hosts: skip the zero-shot safety model (keywords + fine-tuned classifier still run)
# DISABLE_SAFETY_MODEL=true
